          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "qwen3:14b": {
          "name": "Qwen3 14B (Planner)",
          "limit": {
            "context": 32768,
            "output": 6000
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "phi4-mini": {
          "name": "Phi4 Mini",
          "limit": {
            "context": 8000,
            "output": 4000
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    }
  },
  "model_specifications": {
    "dbt": {
      "version": "1.5.0",
      "strategy": "incremental"
